{
  "name": "@j1nn0/vue-modal-dialog",
  "version": "1.0.1",
  "description": "A reusable Vue 3 modal dialog component with focus trap and ARIA support",
  "keywords": [
    "vue",
    "dialog",
    "modal",
    "modal-dialog",
    "focus-trap",
    "accessible"
  ],
  "author": "j1nn0 <j1nn0.github@gmail.com>",
  "license": "MIT",
  "main": "dist/vue-modal-dialog.umd.cjs",
  "module": "dist/vue-modal-dialog.es.js",
  "types": "dist/index.d.ts",
  "style": "dist/vue-modal-dialog.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-modal-dialog.es.js",
      "require": "./dist/vue-modal-dialog.umd.cjs"
    },
    "./style.css": "./dist/vue-modal-dialog.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui --coverage",
    "coverage": "vitest run --coverage",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:fix": "run-s lint:fix:oxlint lint:fix:eslint",
    "lint:fix:oxlint": "oxlint . --fix",
    "lint:fix:eslint": "eslint . --fix",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "size": "size-limit",
    "release": "release-it",
    "upgrade-interactive": "pnpm update --interactive",
    "prepare": "node scripts/check-dev-env.mjs && husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j1nn0/vue-modal-dialog.git"
  },
  "bugs": {
    "url": "https://github.com/j1nn0/vue-modal-dialog/issues"
  },
  "homepage": "https://github.com/j1nn0/vue-modal-dialog#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@release-it/conventional-changelog": "^12.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-vue": "^10.10.0",
    "focus-trap": "^8.2.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "release-it": "^21.0.2",
    "sass-embedded": "^1.102.0",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "focus-trap": "^8.2.2",
    "vue": "^3.5.38"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.6",
      "shell-quote": "^1.10.0"
    }
  }
}
